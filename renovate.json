{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignoreDeps": [
    "org.hamcrest:hamcrest",
    "org.hamcrest:hamcrest-core",
    "com.michael-bull.kotlin-result:kotlin-result",
    "com.michael-bull.kotlin-result:kotlin-result-coroutines"
  ],
  "packageRules": [
    {
      "description": "KMP is also a build-logic library. Its Plugin Portal POM has no SCM URL, so it misses the kotlin monorepo group and opens a second PR for the same version catalog entry.",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin($|[.:])/"
      ],
      "groupName": "kotlin monorepo"
    },
    {
      "description": "Java is pinned to JDK 25 LTS; bump manually on the next LTS",
      "matchDatasources": [
        "java-version"
      ],
      "matchPackageNames": [
        "java",
        "java-jdk",
        "java-jre"
      ],
      "enabled": false
    }
  ]
}
